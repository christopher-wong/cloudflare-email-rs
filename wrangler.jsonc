{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cfemail",
	"main": "worker/build/worker/shim.mjs",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"build": {
		// Run from the project root. `wrangler dev` / `wrangler deploy` must
		// therefore be invoked from the project root too — `npm run dev` and
		// `make dev` already handle that. Wrangler doesn't expose a template
		// variable for the config file's own directory, so we can't make the
		// command self-locating from arbitrary subdirs.
		"command": "npm run web:build && npm run worker:build"
	},
	"assets": {
		"directory": "./web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"vars": {
		// The email domain (right-hand side of every mailbox address).
		"PRIMARY_DOMAIN": "middleseat.vc",
		// Extra domains owned by this instance, comma-separated. Optional.
		"ADDITIONAL_DOMAINS": "",
		// The host the web app is served from. Used as the WebAuthn RP ID and as
		// the expected origin in passkey ceremonies. May differ from the email
		// domain (e.g. mail.middleseat.vc serving christopher@middleseat.vc).
		"APP_HOST": "mail.middleseat.vc",
		"APP_NAME": "cfmail",
		"SESSION_TTL_DAYS": "30",
		// Multi-tenant domain onboarding (bring-your-own Cloudflare domain).
		// Tenant domains are added as full zones in THIS Cloudflare account,
		// then Email Routing's catch-all is pointed at this worker. Requires:
		//   - CF_ACCOUNT_ID (below): the account zones are created under.
		//   - CF_EMAIL_WORKER_NAME (below): the deployed worker script the
		//     catch-all rule targets — must match the top-level "name".
		//   - CF_API_TOKEN: an account-scoped API token with Zone:Edit,
		//     DNS:Edit, and Email Routing:Edit. Set it as a SECRET, never a
		//     var:  `wrangler secret put CF_API_TOKEN`
		"CF_ACCOUNT_ID": "",
		"CF_EMAIL_WORKER_NAME": "cfemail"
	},
	"routes": [
		{
			"pattern": "mail.middleseat.vc",
			"custom_domain": true
		}
	],
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REGISTRY",
				"class_name": "RegistryDO"
			},
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RegistryDO",
				"MailboxDO"
			]
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "cfemail-blobs",
			"binding": "BLOBS"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CONFIG",
			"id": "4c9f2e752d244c70a471d665fd5e5612"
		},
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	// Cron-triggered snapshot of every DO to R2 under backups/<iso>.json.
	// 03:17 UTC daily — quiet hour, off-peak. Match this with the
	// retention policy on the cfemail-blobs bucket (recommended: keep
	// last 14 days, delete older). Manual triggers via
	// POST /api/admin/backup do the same dump on demand.
	"triggers": {
		"crons": ["17 3 * * *"]
	}
}